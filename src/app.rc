#include <winuser.h>
#include <winver.h>

1 RT_MANIFEST "app.manifest"
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Doppler"
            VALUE "FileDescription", "Doppler's File Duplicates Remover"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "DopplersFileDuplicatesRemover"
            VALUE "OriginalFilename", "DopplersFileDuplicatesRemover.exe"
            VALUE "ProductName", "Doppler's File Duplicates Remover"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (C) Doppler"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
